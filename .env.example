# Model provider for the in-app agent and the evaluation runner.
ANTHROPIC_API_KEY=

# Local development: skip sign-in (never in production).
AUTH_DISABLED=true

# Production needs a persistent Postgres and a stable auth secret.
# DATABASE_URL=
# BETTER_AUTH_SECRET=

# Public address (for family links and fonts fetched by functions).
# CHAUPAL_PUBLIC_URL=https://chaupal.prashantthakur.dev

# Optional: family updates to a Telegram chat, sent only after her approval.
# CHAUPAL_TELEGRAM_BOT_TOKEN=
# CHAUPAL_TELEGRAM_CHAT_ID=

# Evaluation harness only: enables the one-time faulty-render fixture.
# CHAUPAL_EVAL=1
